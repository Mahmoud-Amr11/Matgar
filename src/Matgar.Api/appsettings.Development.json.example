{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=.;Initial Catalog=MatgarDB;Integrated Security=True;Encrypt=True;Trust Server Certificate=True;Command Timeout=30",
    "Redis": "localhost:6379"
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },

  "RateLimiting": {
    "GlobalPermitLimit": 100000,
    "AuthPermitLimit": 10000,
    "WindowSeconds": 60
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },

    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.json",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 14,
          "shared": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },

  "EmailOptions": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Email": "<YOUR_GMAIL_ADDRESS>",
    "DisplayName": "Matgar",
    "Password": "<YOUR_GMAIL_APP_PASSWORD>"
  },

  "JwtOptions": {
    "Key": "<32+_BYTE_SECRET>",
    "Issuer": "Matgar.Api",
    "Audience": "Matgar.Client",
    "AccessTokenDurationMinutes": 15,
    "RefreshTokenDurationDays": 15
  }
}