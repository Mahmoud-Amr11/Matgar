{
  "ConnectionStrings": {
    "DefaultConnection": "YOUR_CONNECTION_STRING",
    "Redis": "YOUR_REDIS_CONNECTION_STRING"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "EmailOptions": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Email": "YOUR_GMAIL_ADDRESS",
    "DisplayName": "Matgar",
    "Password": "YOUR_SMTP_PASSWORD"
  },
  "JwtOptions": {
    "Key": "YOUR_JWT_KEY",
    "Issuer": "Matgar.Api",
    "Audience": "Matgar.Client",
    "AccessTokenDurationMinutes": 15,
    "RefreshTokenDurationDays": 15
  }
}