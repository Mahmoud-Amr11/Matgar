# Copy this file to .env and fill in real values. NEVER commit .env.
# Generate secrets with:  openssl rand -base64 48   (PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(64)))

# SQL Server (reachable inside the compose network as "sqlserver", host port 14333)
# Update the password before any production use.
DB_CONNECTION_STRING=Server=sqlserver,1433;Database=MatgarDB;User Id=sa;Password=CHANGE_ME_STRONG_PASSWORD;TrustServerCertificate=True;Encrypt=True;Command Timeout=30;Connect Timeout=30

# Redis (in-container hostname)
REDIS_CONNECTION_STRING=redis:6379

# JWT signing key - MUST be at least 32 bytes (HMAC-SHA256). Never reuse a breached one.
JWT_SIGNING_KEY=CHANGE_ME_openssl_rand_-base64_48

# SMTP (Gmail) - use an App Password, NOT your account password:
# https://myaccount.google.com/apppasswords
EMAIL_ADDRESS=you@gmail.com
EMAIL_APP_PASSWORD=CHANGE_ME_gmail_app_password

# SQL Server SA password (used by the sqlserver container only).
# Must be >= 8 chars and match the Password in DB_CONNECTION_STRING above.
MSSQL_SA_PASSWORD=CHANGE_ME_STRONG_PASSWORD