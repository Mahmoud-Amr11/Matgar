# Copy this file to .env and fill in real values. NEVER commit .env.
# Generate JWT key with: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(64))

# SQL Server (reachable inside compose network as "sqlserver", host port 14333)
DB_CONNECTION_STRING=Server=sqlserver,1433;Database=MatgarDB;User Id=sa;Password=YOUR_SQL_PASSWORD;TrustServerCertificate=True;Encrypt=True;Command Timeout=30;Connect Timeout=30

# Redis connection string
REDIS_CONNECTION_STRING=redis:6379

# JWT signing key (MUST be at least 32 bytes for HMAC-SHA256)
JWT_KEY=YOUR_JWT_KEY

# SMTP / Gmail credentials
EMAIL_ADDRESS=YOUR_GMAIL_ADDRESS
EMAIL_SMTP_PASSWORD=YOUR_SMTP_PASSWORD

# SQL Server SA password for container startup
MSSQL_SA_PASSWORD=YOUR_SQL_PASSWORD